# Secrets-only environment template.
# Copy to .env locally and keep all values empty in this tracked example.
# Do not add non-secret installation or strategy config here; use configs/*.yaml.

# Read-only API token for dashboard/mobile status access.
API_READ_TOKEN=

# Frontend/mobile copy of the read-only token for market data and status endpoints.
VITE_API_READ_TOKEN=

# Admin API token for privileged operations. Admin may satisfy read-only checks; read-only must never satisfy admin checks.
API_ADMIN_TOKEN=

# Limited device token used by clients to register/unregister push notification tokens.
API_DEVICE_TOKEN=

# Frontend/mobile copy of the limited device token for push-token registration only.
VITE_API_DEVICE_TOKEN=

# Limited token used only to synchronize alert configuration.
API_ALERTS_TOKEN=

# Frontend/mobile copy of the limited alert synchronization token.
VITE_API_ALERTS_TOKEN=

# Backend base URL per il build CI (in locale viene letta da configs/instance.yaml → frontend.backend_api_base_url).
# Impostare come GitHub secret VITE_BACKEND_API_BASE_URL solo per le build CI/CD.
# VITE_BACKEND_API_BASE_URL=

# Secret pepper for hashing stored API tokens or similar local credentials.
TOKEN_HASH_PEPPER=

# Database URL only when it embeds credentials or points to a managed secret-bearing database.
DATABASE_URL=

# CoinMarketCap API key.
CMC_API_KEY=

# Tatum RPC API key (optional, for authenticated RPC endpoints).
TATUM_RPC_API_KEY=

# Anthropic API key for the agent meta-controller.
ANTHROPIC_API_KEY=

# Trust Wallet Agent Kit access identifier.
TWAK_ACCESS_ID=

# Trust Wallet Agent Kit HMAC secret.
TWAK_HMAC_SECRET=

# Trust Wallet Agent Kit REST API base URL. Leave empty to use default: https://tws.trustwallet.com
TWAK_API_BASE_URL=

# Trust Wallet Agent Kit CLI executable path. Leave empty to use default: twak (must be on PATH).
TWAK_CLI_PATH=

# Trust Wallet Agent Kit wallet password. Prefer scripts/twak-password-file.cjs on Windows if the password has non-ASCII characters.
TWAK_WALLET_PASSWORD=

# Path to Web3 encrypted keystore file (created by backend/scripts/encrypt_wallet.py).
WALLET_ENCRYPTED_PRIVATE_KEY_PATH=

# Name of the environment variable that contains the keystore passphrase.
WALLET_KEY_PASSPHRASE_ENV=

# Path to Firebase service account JSON. Treat paths to service-account files as sensitive.
FCM_CREDENTIALS_PATH=

# Spesa Claude pregressa non tracciata dal DB (USD), sommata al costo registrato
# per allinearsi alla console Anthropic. Es. 0.91 = differenza tra speso reale e tracciato.
ANTHROPIC_COST_BASELINE_USD=0

# --- Routing token per l'esecuzione SPOT in LIVE (non usati in dry-run) ---
# Solo per execution_mode=live. Con CMC_API_KEY configurata gli indirizzi BSC vengono
# risolti AUTOMATICAMENTE da CoinMarketCap (cache in memoria, nessun archivio).
# Le variabili qui sotto sono override OPZIONALI per fissare indirizzi specifici/verificati.
# Indirizzo del token di quote (default: USDT risolto via CMC). Decimali default 18.
SPOT_QUOTE_TOKEN_ADDRESS=
SPOT_QUOTE_TOKEN_DECIMALS=18
# Override mappa JSON symbol -> "indirizzo" o "indirizzo:decimali" (vince sulla risoluzione CMC).
# Esempio: {"ETH":"0x2170Ed0880ac9A755fd29B2688956BD959F933F8"}
SPOT_TOKEN_MAP=

# --- Aster DEX (perp execution venue) ---
# Abilita/disabilita il venue Aster. Default: false.
ASTER_ENABLED=false
# Base URL delle API Aster futures. Default: https://fapi.asterdex.com
ASTER_BASE_URL=
# Indirizzo dell'account principale su Aster.
ASTER_ACCOUNT_ADDRESS=
# Indirizzo del wallet API (sub-account) su Aster.
ASTER_API_WALLET_ADDRESS=
# Chiave privata del wallet API per la firma EIP-712. MAI condividere.
ASTER_API_WALLET_PRIVATE_KEY=
# Nome del sub-account Aster (opzionale).
ASTER_SUBACCOUNT_NAME=
